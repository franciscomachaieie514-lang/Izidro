# PostgreSQL used for Izidro accounts and sessions
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Public URL of the deployed Izidro app
APP_URL=https://YOUR-IZIDRO-DOMAIN

# OAuth 2.0 client created in the Deriv developer dashboard
DERIV_CLIENT_ID=YOUR_DERIV_OAUTH_CLIENT_ID

# Do not commit real secrets. Configure these values in the deployment provider.
