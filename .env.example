# PostgreSQL used for Izidro accounts and sessions
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Canonical public URL (use https://izitrader.app in production)
APP_URL=https://YOUR-IZIDRO-DOMAIN
NEXT_PUBLIC_APP_URL=https://YOUR-IZIDRO-DOMAIN

# Deriv OAuth / API client identifiers
DERIV_CLIENT_ID=YOUR_DERIV_OAUTH_CLIENT_ID
DERIV_APP_ID=YOUR_DERIV_APP_ID

# Password reset email
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Izitrader <verified@your-domain>

# Do not commit real secrets. Configure these values in Render.
